" echo 'Hello vim.'

filetype plugin indent on
syntax enable

set background=dark

set encoding=utf-8
set fileencodings=cp932,iso-2022-jp,euc-jp,sjis,utf-8
set fileformats=unix,dos,mac
set number
set ruler
set wildmenu
set clipboard&
set clipboard^=unnamedplus
set backspace=indent,eol,start
set nobackup
set noswapfile
set autoread
set hidden
set cursorline
set smartindent
set belloff=all
set showmatch
set showcmd
set laststatus=2
set wildmode=list:longest
set list
set tabstop=4

set ignorecase
set smartcase
set incsearch
set wrapscan
set hlsearch

nmap <Esc><Esc> :nohlsearch<CR><Esc>

