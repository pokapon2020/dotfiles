{
  "workbench.startupEditor": "none",
  "git.autofetch": true,
  "redhat.telemetry.enabled": true,
  "editor.fontFamily": "'PlemolJP Console NF', Consolas, 'Courier New', monospace",
  "markdown.marp.enableHtml": true,
  "docker.commands.attach": "${containerCommand} exec -it ${containerId} ${shellCommand}",
  "githubPullRequests.pullBranch": "never",
  "githubPullRequests.fileListLayout": "tree",
  "hediet.vscode-drawio.resizeImages": null,
  "hediet.vscode-drawio.theme": "kennedy",
  "snowflake.connectionsConfigFile": "C:\\Users\\toriyabe\\.snowflake\\connections.toml",
  "msg.dbEditor.connectionBrowser.showGreeting": false,
  "msg.shellSession.sessionBrowser.showGreeting": false,
  "excalidraw.theme": "light",
  "hediet.vscode-drawio.codeLinkActivated": true,
  "workbench.colorTheme": "Ayu Mirage Zed",
  "markdown.marp.pptx.editable": "on",
  "containers.commands.attach": "${containerCommand} exec -it ${containerId} ${shellCommand}",
  "openapi.internalFeatures": false,
  "openapi.internalUseDevEndpoints": false,
  "openapi.approvedHostnames": [],
  "workbench.iconTheme": "ayu-mirage-zed",
  "editor.fontSize": 16,
  "dev.containers.executeInWSL": true,
  "dev.containers.executeInWSLDistro": "archlinux",
  "cSpell.userWords": [
    "exceljs",
    "geppo",
    "Hatsu",
    "hatsuden",
    "hatsudenki",
    "Heiretsu",
    "highlow",
    "Hoannisshi",
    "HRSG",
    "jepx",
    "Jikan",
    "jisseki",
    "Junpo",
    "Kairetsu",
    "KAWAGOE",
    "Mgmt",
    "msumt",
    "Ondo",
    "Repower",
    "Syutsuryoku"
  ],
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "typescript": true
  },
  "dev.containers.defaultExtensions": [
    "streetsidesoftware.code-spell-checker",
    "eamodio.gitlens",
    "humao.rest-client"
  ],
  "dev.containers.defaultFeatures": {
    "ghcr.io/larsnieuwenhuizen/features/neovim:0": {},
    "ghcr.io/prulloac/devcontainer-features/chezmoi:1": {}
  }
}
